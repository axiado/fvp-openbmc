diff --git a/redfishhandler.cpp b/redfishhandler.cpp
new file mode 100644
index 0000000..3fa9df5
--- /dev/null
+++ b/redfishhandler.cpp
@@ -0,0 +1,132 @@
+#include "redfishhandler.hpp"
+
+#include <openssl/pem.h>
+#include <openssl/x509.h>
+
+#include <ipmid/api.hpp>
+#include <ipmid/types.hpp>
+#include <ipmid/utils.hpp>
+#include <phosphor-logging/lg2.hpp>
+#include <user_channel/user_layer.hpp>
+#include <user_channel/user_mgmt.hpp>
+
+#include <random>
+
+void register_netfn_redfish_functions() __attribute__((constructor));
+
+namespace ipmi
+{
+
+ipmi::RspType<std::vector<uint8_t>> ipmiGetBootstrapAccount(
+    ipmi::Context::ptr ctx, uint8_t bootstrapControl)
+{
+    ipmi::ChannelInfo chInfo;
+    std::string userName;
+    std::string password;
+    char buffer[bootstrapAccLen] = {};
+    uint8_t userId = 1;
+    ipmi::UsersTbl* userData;
+    std::vector<uint8_t> dataOut;
+
+    if (ipmi::getChannelInfo(ctx->channel, chInfo) != ipmi::ccSuccess)
+    {
+        lg2::error("Failed to get Channel Info, channel={CHANNEL}", "CHANNEL",
+                   ctx->channel);
+        return ipmi::responseUnspecifiedError();
+    }
+
+    // TODO : Handle Bootstrap Control
+    (void)bootstrapControl;
+
+    // TODO : now only return the default username and password
+    userData = ipmi::getUserAccessObject().getUsersTblPtr();
+    if (!userData->user[userId].userInSystem)
+    {
+        return ipmi::responseUnspecifiedError();
+    }
+
+    ipmiUserGetUserName(userId, userName);
+    SecureString securityPassword = ipmiUserGetPassword(userName);
+
+    password = securityPassword;
+
+    /* Respond data */
+    memcpy(buffer, userName.c_str(), userName.length());
+    memcpy(buffer + maxPasswordSize, password.c_str(), password.length());
+    dataOut.assign(buffer, buffer + bootstrapAccLen);
+
+    return ipmi::responseSuccess(dataOut);
+}
+
+ipmi::RspType<std::vector<uint8_t>> ipmiGetRedfishCertificateFingerprint(
+    ipmi::Context::ptr ctx, uint8_t certNum)
+{
+    ipmi::ChannelInfo chInfo;
+    const EVP_MD* fdig = EVP_sha256();
+    unsigned int n;
+
+    if (ipmi::getChannelInfo(ctx->channel, chInfo) != ipmi::ccSuccess)
+    {
+        lg2::error("Failed to get Channel Info, channel={CHANNEL}", "CHANNEL",
+                   ctx->channel);
+        return ipmi::responseUnspecifiedError();
+    }
+
+    if (certNum != 1)
+    {
+        lg2::error("Invalid certificate number - {NUMBER}", "NUMBER", certNum);
+        return ipmi::response(ipmiInvalidCertificateNumber);
+    }
+
+    BIO* cert;
+    X509* x = NULL;
+    cert = BIO_new_file(defaultCertPath, "rb");
+    if (cert == NULL)
+    {
+        lg2::error("Unable to open certificate - {CERT}", "CERT",
+                   defaultCertPath);
+        return ipmi::response(ipmi::ccResponseError);
+    }
+
+    x = PEM_read_bio_X509_AUX(cert, NULL, NULL, NULL);
+    if (x == NULL)
+    {
+        BIO_free(cert);
+        lg2::error("Unable to load certificate from X509");
+        return ipmi::response(ipmi::ccResponseError);
+    }
+
+    std::vector<uint8_t> fingerPrintData(EVP_MAX_MD_SIZE);
+    if (!X509_digest(x, fdig, fingerPrintData.data(), &n))
+    {
+        X509_free(x);
+        BIO_free(cert);
+        lg2::error("X509 Out of memory");
+        return ipmi::response(ipmi::ccResponseError);
+    }
+
+    X509_free(x);
+    BIO_free(cert);
+
+    std::vector<uint8_t> respBuf;
+
+    respBuf.push_back(1); // Default 01h: SHA-256.
+    respBuf.insert(respBuf.end(), fingerPrintData.begin(),
+                   fingerPrintData.begin() + n);
+
+    return ipmi::responseSuccess(respBuf);
+}
+
+} // namespace ipmi
+
+void register_netfn_redfish_functions()
+{
+    registerGroupHandler(ipmi::prioOpenBmcBase, ipmi::groupRedfishHI,
+                         ipmi::redfish::cmdGetBootstrapAccoutCredential,
+                         ipmi::Privilege::User, ipmi::ipmiGetBootstrapAccount);
+
+    registerGroupHandler(ipmi::prioOpenBmcBase, ipmi::groupRedfishHI,
+                         ipmi::redfish::cmdGetCertificateFingerprint,
+                         ipmi::Privilege::User,
+                         ipmi::ipmiGetRedfishCertificateFingerprint);
+}
