--- /dev/null
+++ b/redfishhandler.hpp
@@ -0,0 +1,11 @@
+#include <cstdint>
+
+#pragma once
+
+constexpr uint8_t bootstrapAccLen = 32;
+constexpr uint8_t maxPasswordSize = 16;
+
+constexpr uint8_t ipmiInvalidCertificateNumber = 0xCB;
+
+// Cert Paths
+constexpr auto defaultCertPath = "/etc/ssl/certs/https/server.pem";
