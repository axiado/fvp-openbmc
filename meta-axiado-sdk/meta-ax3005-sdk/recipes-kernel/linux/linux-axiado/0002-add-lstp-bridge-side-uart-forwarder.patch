index 9f441e804de3..027dfc9e7ae7 100644
--- a/Documentation/devicetree/bindings/usb/nvidia,lstp.yaml
+++ b/Documentation/devicetree/bindings/usb/nvidia,lstp.yaml
@@ -48,15 +48,19 @@ patternProperties:
         description: LSTP channel identifier.
 
       nvidia,channel-type:
-        enum: [management, i2c, gpio, spi, uart, virtual-uart]
+        enum: [management, i2c, gpio, spi, uart, uart-tty, virtual-uart]
         description: |
           Channel type as reported to the host.  Exactly one channel of
           type "management" must exist and it must be channel 0.
 
-          "uart" and "virtual-uart" are both reported to the host as UART
-          channels.  A "uart" channel hands over one of the local serial
-          controllers, a "virtual-uart" channel has no controller behind it
-          and shows up locally as /dev/ttyVUARTn instead.
+          "uart", "uart-tty" and "virtual-uart" are all reported to the host
+          as UART channels.  A "uart" channel hands over one of the local
+          serial controllers through the serial device bus and a "uart-tty"
+          channel hands over the same kind of controller through the tty
+          layer, which costs one buffer hop and in exchange lets the host set
+          the whole character framing instead of 8N1 only.  A "virtual-uart"
+          channel has no controller behind it and shows up locally as
+          /dev/ttyVUARTn instead.
 
       nvidia,channel-name:
         $ref: /schemas/types.yaml#/definitions/string
@@ -174,6 +178,89 @@ patternProperties:
           required:
             - uart
 
+      - if:
+          properties:
+            nvidia,channel-type:
+              const: uart-tty
+        then:
+          description: |
+            A tty backed UART channel points straight at the serial
+            controller, so unlike a "uart" channel it needs no LSTP specific
+            child node under it.  The channel claims that controller's tty
+            for the kernel while it exists, which takes it away from
+            userspace, and puts a line discipline of its own on it.
+
+            Everything the port cannot do is refused rather than silently
+            downgraded: the framing below is programmed through termios and
+            read back, and a mismatch fails the probe or answers a host
+            WriteConfig with NOT_SUPPORTED.
+          properties:
+            uart:
+              $ref: /schemas/types.yaml#/definitions/phandle
+              description: |
+                Points at the serial controller whose port this channel
+                drives, for example <&uart6>.  The channel probe defers until
+                the controller has registered its tty.  A controller with
+                more than one port is not supported here; the first tty below
+                it is taken.
+
+            nvidia,tty-name:
+              $ref: /schemas/types.yaml#/definitions/string
+              description: |
+                Alternative to the uart phandle for a port that has no
+                controller node to point at, such as a USB serial adapter:
+                the tty device name without the /dev/ prefix, for example
+                "ttyUSB0".  Ignored when uart is present.
+
+            current-speed:
+              default: 115200
+              description: Initial baud rate, also reported to the host.
+
+            nvidia,data-bits:
+              $ref: /schemas/types.yaml#/definitions/uint32
+              enum: [5, 6, 7, 8]
+              default: 8
+              description: Initial data bits, also reported to the host.
+
+            nvidia,stop-bits:
+              $ref: /schemas/types.yaml#/definitions/uint32
+              enum: [1, 2]
+              default: 1
+              description: Initial stop bits, also reported to the host.
+
+            nvidia,parity:
+              enum: [none, odd, even, mark, space]
+              default: none
+              description: Initial parity, also reported to the host.
+
+            nvidia,flow-control:
+              enum: [none, xon-xoff, rts-cts, dtr-dsr]
+              default: none
+              description: |
+                Initial flow control, also reported to the host.  Only the
+                RTS/CTS lines are driven, so "xon-xoff" and "dtr-dsr" are
+                rejected.
+
+            nvidia,drive-strength-ma:
+              $ref: /schemas/types.yaml#/definitions/uint32
+              description: Reported drive strength, in mA.
+
+            nvidia,slew-rate:
+              $ref: /schemas/types.yaml#/definitions/uint32
+              description: Reported slew rate, in 100 ps steps.
+
+            nvidia,input-debounce-us:
+              $ref: /schemas/types.yaml#/definitions/uint32
+              description: Reported input debounce time, in us.
+
+            nvidia,glitch-filter-ns:
+              $ref: /schemas/types.yaml#/definitions/uint32
+              description: Reported glitch filter width, in ns.
+
+          oneOf:
+            - required: [uart]
+            - required: [nvidia,tty-name]
+
       - if:
           properties:
             nvidia,channel-type:
@@ -360,6 +447,10 @@ examples:
         };
     };
 
+    /* A "uart-tty" channel points at the controller itself, not at a child. */
+    uart1: serial-1 {
+    };
+
     lstp {
         compatible = "nvidia,lstp";
         #address-cells = <1>;
@@ -421,6 +512,17 @@ examples:
 
         channel@5 {
             reg = <5>;
+            nvidia,channel-type = "uart-tty";
+            nvidia,channel-name = "HOST_DBG";
+            uart = <&uart1>;
+            current-speed = <115200>;
+            nvidia,data-bits = <7>;
+            nvidia,stop-bits = <1>;
+            nvidia,parity = "even";
+        };
+
+        channel@6 {
+            reg = <6>;
             nvidia,channel-type = "virtual-uart";
             nvidia,channel-name = "BMC_SOL";
             current-speed = <115200>;
