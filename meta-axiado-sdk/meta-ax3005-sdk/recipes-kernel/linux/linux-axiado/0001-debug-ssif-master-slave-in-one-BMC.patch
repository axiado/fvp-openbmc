--- a/drivers/char/ipmi/ipmi_ssif.c
+++ b/drivers/char/ipmi/ipmi_ssif.c
@@ -1321,7 +1321,9 @@ static int do_cmd(struct i2c_client *client, int len, unsigned char *msg,
 
 	retry_cnt = SSIF_SEND_RETRIES;
  retry1:
+	pr_info("%s():%d\t[ipmi ssif] i2c_client->addr: 0x%02x, -----------------> retry_cnt: %d\n", __func__, __LINE__, client->addr, retry_cnt);
 	ret = i2c_smbus_write_block_data(client, SSIF_IPMI_REQUEST, len, msg);
+	pr_info("%s():%d\t[ipmi ssif] i2c_client->addr: 0x%02x, -----------------> ret: %d\n", __func__, __LINE__, client->addr, ret);
 	if (ret) {
 		retry_cnt--;
 		if (retry_cnt > 0) {
@@ -1331,7 +1333,9 @@ static int do_cmd(struct i2c_client *client, int len, unsigned char *msg,
 		return -ENODEV;
 	}
 
+	pr_info("%s():%d\t[ipmi ssif] i2c_client->addr: 0x%02x, -----------------> read_response\n", __func__, __LINE__, client->addr);
 	ret = read_response(client, resp);
+	pr_info("%s():%d\t[ipmi ssif] i2c_client->addr: 0x%02x, -----------------> read_response, ret: %d\n", __func__, __LINE__, client->addr, ret);
 	if (ret > 0) {
 		/* Validate that the response is correct. */
 		if (ret < 3 ||
@@ -1356,6 +1360,7 @@ static int ssif_detect(struct i2c_client *client, struct i2c_board_info *info)
 	int           rv;
 	int           len;
 
+	pr_info("%s():%d\t[ipmi ssif] ##################### driver->detect, client->addr: 0x%02x\n", __func__, __LINE__, client->addr);
 	resp = kmalloc(IPMI_MAX_MSG_LENGTH, GFP_KERNEL);
 	if (!resp)
 		return -ENOMEM;
@@ -1364,6 +1369,7 @@ static int ssif_detect(struct i2c_client *client, struct i2c_board_info *info)
 	msg[0] = IPMI_NETFN_APP_REQUEST << 2;
 	msg[1] = IPMI_GET_DEVICE_ID_CMD;
 	rv = do_cmd(client, 2, msg, &len, resp);
+	pr_info("%s():%d\t[ipmi ssif] driver->detect, len: %d, rv: %d\n", __func__, __LINE__, len, rv);
 	if (rv)
 		rv = -ENODEV;
 	else {
@@ -1662,6 +1668,8 @@ static int ssif_probe(struct i2c_client *client)
 	u8		  slave_addr = 0;
 	struct ssif_addr_info *addr_info = NULL;
 
+	pr_info("%s():%d\t[ipmi ssif] probe =========================\n", __func__, __LINE__);
+
 	mutex_lock(&ssif_infos_mutex);
 	resp = kmalloc(IPMI_MAX_MSG_LENGTH, GFP_KERNEL);
 	if (!resp) {
@@ -1669,6 +1677,7 @@ static int ssif_probe(struct i2c_client *client)
 		return -ENOMEM;
 	}
 
+	pr_info("%s():%d\t[ipmi ssif] probe\n", __func__, __LINE__);
 	ssif_info = kzalloc(sizeof(*ssif_info), GFP_KERNEL);
 	if (!ssif_info) {
 		kfree(resp);
@@ -1691,6 +1700,9 @@ static int ssif_probe(struct i2c_client *client)
 		}
 	}
 
+	pr_info("%s():%d\t[ipmi ssif] probe\n", __func__, __LINE__);
+
+
 	ssif_info->client = client;
 	i2c_set_clientdata(client, ssif_info);
 
@@ -1707,6 +1719,7 @@ static int ssif_probe(struct i2c_client *client)
 		goto out;
 	}
 
+	pr_info("%s():%d\t[ipmi ssif] probe\n", __func__, __LINE__);
 	slave_addr = find_slave_address(client, slave_addr);
 
 	dev_info(&client->dev,
@@ -1718,17 +1731,21 @@ static int ssif_probe(struct i2c_client *client)
 	 * Send a get device id command and validate its response to
 	 * make sure a valid BMC is there.
 	 */
+	pr_info("%s():%d\t[ipmi ssif] probe, #################### SSIF_DETECT\n", __func__, __LINE__);
 	rv = ssif_detect(client, NULL);
+	pr_info("%s():%d\t[ipmi ssif] probe, #################### SSIF_DETECT, rv: %d\n", __func__, __LINE__, rv);
 	if (rv) {
 		dev_err(&client->dev, "Not present\n");
 		goto out;
 	}
 
+	pr_info("%s():%d\t[ipmi ssif] probe --> IPMI_GET_SYSTEM_INTERFACE_CAPABILITIES_CMD\n", __func__, __LINE__);
 	/* Now check for system interface capabilities */
 	msg[0] = IPMI_NETFN_APP_REQUEST << 2;
 	msg[1] = IPMI_GET_SYSTEM_INTERFACE_CAPABILITIES_CMD;
 	msg[2] = 0; /* SSIF */
 	rv = do_cmd(client, 3, msg, &len, resp);
+	pr_info("%s():%d\t[ipmi ssif] probe --> IPMI_GET_SYSTEM_INTERFACE_CAPABILITIES_CMD, rv: %d\n", __func__, __LINE__, rv);
 	if (!rv && (len >= 3) && (resp[2] == 0)) {
 		if (len < 7) {
 			if (ssif_dbg_probe)
@@ -1782,6 +1799,7 @@ static int ssif_probe(struct i2c_client *client)
 
 	test_multipart_messages(client, ssif_info, resp);
 
+	pr_info("%s():%d\t[ipmi ssif] probe\n", __func__, __LINE__);
 	/* Make sure the NMI timeout is cleared. */
 	msg[0] = IPMI_NETFN_APP_REQUEST << 2;
 	msg[1] = IPMI_CLEAR_MSG_FLAGS_CMD;
@@ -1906,6 +1924,7 @@ static int ssif_probe(struct i2c_client *client)
 		goto out;
 	}
 
+	pr_info("%s():%d\t[ipmi ssif] probe, CALL ipmi_register_smi\n", __func__, __LINE__);
 	rv = ipmi_register_smi(&ssif_info->handlers,
 			       ssif_info,
 			       &ssif_info->client->dev,
@@ -1928,6 +1947,7 @@ static int ssif_probe(struct i2c_client *client)
 	}
 	kfree(resp);
 	mutex_unlock(&ssif_infos_mutex);
+	pr_info("%s():%d\t[ipmi ssif] probe, rv: %d\n", __func__, __LINE__, rv);
 	return rv;
 
 out_remove_attr:
@@ -2126,16 +2146,25 @@ static int __init init_ipmi_ssif(void)
 
 	pr_info("IPMI SSIF Interface driver\n");
 
+#if 1
+	pr_info("%s():%d\t[ipmi ssif] [INIT] num_addrs: %d\n", __func__, __LINE__, num_addrs);
+	for (int iii = 0; iii < num_addrs; ++iii) {
+		pr_info("%s():%d\t[ipmi ssif] [INIT] addr[%d]: 0x%x\n", __func__, __LINE__, iii, addr[iii]);
+	}
+#endif
+
 	/* build list for i2c from addr list */
 	for (i = 0; i < num_addrs; i++) {
 		rv = new_ssif_client(addr[i], adapter_name[i],
 				     dbg[i], slave_addrs[i],
 				     SI_HARDCODED, NULL);
+		pr_info("%s():%d\t[ipmi ssif] [INIT] rv: %d\n", __func__, __LINE__, rv);
 		if (rv)
 			pr_err("Couldn't add hardcoded device at addr 0x%x\n",
 			       addr[i]);
 	}
 
+	pr_info("%s():%d\t[ipmi ssif] [INIT] ssif_tryacpi: %d, ssif_trydmi: %d\n", __func__, __LINE__, ssif_tryacpi, ssif_trydmi);
 	if (ssif_tryacpi)
 		ssif_i2c_driver.driver.acpi_match_table	=
 			ACPI_PTR(ssif_acpi_match);
@@ -2151,6 +2180,7 @@ static int __init init_ipmi_ssif(void)
 	ssif_i2c_driver.address_list = ssif_address_list();
 
 	rv = i2c_add_driver(&ssif_i2c_driver);
+	pr_info("%s():%d\t[ipmi ssif] [INIT] rv: %d\n", __func__, __LINE__, rv);
 	if (!rv)
 		initialized = true;
 
diff --git a/drivers/char/ipmi/ssif_bmc.c b/drivers/char/ipmi/ssif_bmc.c
