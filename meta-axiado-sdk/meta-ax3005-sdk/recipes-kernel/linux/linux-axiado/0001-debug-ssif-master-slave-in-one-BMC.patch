+	pr_info("%s():%d\t[SSIF S] read\n", __func__, __LINE__);
+#endif
 	if (kfifo_is_empty(&ssif_bmc->fifo)) {
 		if (file->f_flags & O_NONBLOCK)
 			return -EAGAIN;
@@ -192,6 +198,9 @@ static ssize_t ssif_bmc_read(struct file *file, char __user *buf, size_t count_i
 			return ret; 
 	}
 	spin_lock_irqsave(&ssif_bmc->lock_rd, flags);
+#ifdef LOUIS_DEBUG
+	pr_info("%s():%d\t[SSIF S] read to user\n", __func__, __LINE__);
+#endif
 	ret = kfifo_to_user(&ssif_bmc->fifo, buf, count_in, &count_out);
 	spin_unlock_irqrestore(&ssif_bmc->lock_rd, flags);
 	return (ret < 0) ? ret : count_out;
@@ -300,6 +309,9 @@ static ssize_t ssif_bmc_write(struct file *file, const char __user *buf, size_t
 	ktime_t now;
 	s64 timer;
 
+#ifdef LOUIS_DEBUG
+	pr_info("%s():%d\t[SSIF S] write\n", __func__, __LINE__);
+#endif
 	if (count > sizeof(struct ipmi_ssif_msg))
 		return -EINVAL;
 
@@ -324,12 +336,18 @@ static ssize_t ssif_bmc_write(struct file *file, const char __user *buf, size_t
 	spin_lock_irqsave(&ssif_bmc->lock_wr, flags);
 	memcpy(&ssif_bmc->response, &msg, count);
 	ssif_bmc->is_singlepart_read = (msg.header.len <= MAX_PAYLOAD_PER_TRANSACTION);
+#ifdef LOUIS_DEBUG
+	pr_info("%s():%d\t[SSIF S] write, ssif_bmc->is_singlepart_read: %d\n", __func__, __LINE__, ssif_bmc->is_singlepart_read);
+#endif
 	spin_unlock_irqrestore(&ssif_bmc->lock_wr, flags);
 
 	timer_delete_sync(&ssif_bmc->response_timer);
 	ssif_bmc->busy = false;
 	cdns_i2c_slave_set_busy(ssif_bmc->client->adapter, ssif_bmc->busy);
 	if (!IS_ERR(ssif_bmc->alert)) {
+#ifdef LOUIS_DEBUG
+		pr_info("%s():%d\t[SSIF S] write, alert\n", __func__, __LINE__);
+#endif
 		//if gpio is already asserted toggle it
 		if (gpiod_get_value(ssif_bmc->alert))
 		{
@@ -340,6 +358,9 @@ static ssize_t ssif_bmc_write(struct file *file, const char __user *buf, size_t
 		gpiod_set_value(ssif_bmc->alert, 1);
 	}
 
+#ifdef LOUIS_DEBUG
+	pr_info("%s():%d\t[SSIF S] write, ret: %d\n", __func__, __LINE__, ret);
+#endif
 	return (ret < 0) ? ret : count;
 }
 
@@ -348,11 +369,17 @@ static int ssif_bmc_open(struct inode *inode, struct file *file)
 	struct ssif_bmc_ctx *ssif_bmc = to_ssif_bmc(file);
 	int ret = 0;
 
+#ifdef LOUIS_DEBUG
+	pr_info("%s():%d\t[SSIF S] open\n", __func__, __LINE__);
+#endif
 	if (!ssif_bmc->running)
 		ssif_bmc->running = 1;
 	else
 		ret = -EBUSY;
 
+#ifdef LOUIS_DEBUG
+	pr_info("%s():%d\t[SSIF S] open, ret: %d\n", __func__, __LINE__, ret);
+#endif
 	return ret;
 }
 
@@ -388,11 +415,19 @@ static const struct file_operations ssif_bmc_fops = {
 	.poll		= ssif_bmc_poll,
 };
 
+
+
+// TODO dump data
 /* Called with ssif_bmc->lock held. */
 static void handle_request(struct ssif_bmc_ctx *ssif_bmc)
 {
 	unsigned long flags = 0;
 	int rc = 0;
+
+#ifdef LOUIS_DEBUG
+	pr_info("%s():%d\t[SSIF S] [handle_request] ssif_bmc->request.header.len: %d\n", __func__, __LINE__, ssif_bmc->request.header.len);
+#endif
+
 #ifdef CONFIG_SEPARATE_SSIF_POSTCODES
 	int netfn = ssif_bmc->request.payload[0] >> 2;
 	int cmd = ssif_bmc->request.payload[1];
@@ -404,28 +439,50 @@ static void handle_request(struct ssif_bmc_ctx *ssif_bmc)
 #endif //CONFIG_SEPARATE_SSIF_POSTCODES
 	if (kfifo_initialized(&ssif_bmc->fifo)) {
 		ssize_t to_send = sizeof(struct ipmi_ssif_msg_header) + ssif_bmc->request.header.len;
-		if (to_send > BUFFER_SIZE) {
+		if (to_send > BUFFER_SIZE /* 1024 */) {
 			return;
 		}
 
 		if ((BUFFER_SIZE - kfifo_len(&ssif_bmc->fifo)) < to_send)
 			kfifo_reset(&ssif_bmc->fifo);
 
+#ifdef LOUIS_DEBUG
+		pr_info("%s():%d\t[SSIF S] [handle_request] debug\n", __func__, __LINE__);
+#endif
+
+
+
+
+
+
 		spin_lock_irqsave(&ssif_bmc->lock_rd, flags);
+
 		rc = kfifo_in(&ssif_bmc->fifo, &ssif_bmc->request.header,  sizeof(struct ipmi_ssif_msg_header));
+#ifdef LOUIS_DEBUG
+		pr_info("%s():%d\t[SSIF S] [handle_request] debug, kfifo_in rc: %d\n", __func__, __LINE__, rc);
+#endif
 		if (rc != sizeof(struct ipmi_ssif_msg_header)) {
 			kfifo_reset(&ssif_bmc->fifo);
 			spin_unlock_irqrestore(&ssif_bmc->lock_rd, flags);
 			return;
 		}
-		to_send = min_t(ssize_t, ssif_bmc->request.header.len, IPMI_SSIF_PAYLOAD_MAX);
+
+		to_send = min_t(ssize_t, ssif_bmc->request.header.len, IPMI_SSIF_PAYLOAD_MAX /* 254 */);
 		rc = kfifo_in(&ssif_bmc->fifo, ssif_bmc->request.payload, to_send);
+#ifdef LOUIS_DEBUG
+		pr_info("%s():%d\t[SSIF S] [handle_request] debug, kfifo_in rc: %d\n", __func__, __LINE__, rc);
+#endif
 		spin_unlock_irqrestore(&ssif_bmc->lock_rd, flags);
+
 		if (rc != to_send) {
 			kfifo_reset(&ssif_bmc->fifo);
 			return;
 		}
 
+
+
+
+
 		ssif_bmc->busy = true;
 		cdns_i2c_slave_set_busy(ssif_bmc->client->adapter, ssif_bmc->busy);
 		mod_timer(&ssif_bmc->response_timer, jiffies + msecs_to_jiffies(ssif_bmc->response_timeout));
@@ -436,6 +493,12 @@ static void handle_request(struct ssif_bmc_ctx *ssif_bmc)
 	}
 }
 
+
+
+
+
+
+
 static void calculate_response_part_pec(struct ssif_part_buffer *part)
 {
 	u8 addr = part->address;
@@ -595,7 +658,13 @@ static void handle_write_received(struct ssif_bmc_ctx *ssif_bmc, u8 *val)
 	if (ssif_bmc->msg_idx == 1) {
 		ssif_bmc->part_buf.length = *val;
 		ssif_bmc->part_buf.index = 0;
+#ifdef LOUIS_DEBUG
+		pr_info("%s():%d\t[SSIF S] ssif_bmc->part_buf.length: %u\n", __func__, __LINE__, *val);
+#endif
 	} else {
+#ifdef LOUIS_DEBUG
+		pr_info("%s():%d\t[SSIF S] ssif_bmc->part_buf.payload[%d]: %u\n", __func__, __LINE__, ssif_bmc->part_buf.index, *val);
+#endif
 		ssif_bmc->part_buf.payload[ssif_bmc->part_buf.index++] = *val;
 	}
 
@@ -613,18 +682,38 @@ static bool validate_request_part(struct ssif_bmc_ctx *ssif_bmc)
 		/* PEC is not included */
 		ssif_bmc->pec_support = false;
 		ret = true;
+#ifdef LOUIS_DEBUG
+		pr_info("%s():%d\t[SSIF S] [validate_request_part] NO PEC\n", __func__, __LINE__);
+#endif
 		goto exit;
 	}
 
 	if (part->index != part->length + 1) {
 		ret = false;
+#ifdef LOUIS_DEBUG
+		pr_info("%s():%d\t[SSIF S] [validate_request_part] ERR\n", __func__, __LINE__);
+#endif
 		goto exit;
 	}
 
+#ifdef LOUIS_DEBUG
+	pr_info("%s():%d\t[SSIF S] [validate_request_part] part->address: 0x%x\n", __func__, __LINE__, part->address);
+	pr_info("%s():%d\t[SSIF S] [validate_request_part] part->smbus_cmd: 0x%x\n", __func__, __LINE__, part->smbus_cmd);
+	pr_info("%s():%d\t[SSIF S] [validate_request_part] part->length: %u\n", __func__, __LINE__, part->length);
+	for (uint ii = 0; ii < part->length; ++ii) {
+		pr_info("%s():%d\t[SSIF S] [validate_request_part] part->payload[%u]: 0x%x\n", __func__, __LINE__, ii, part->payload[ii]);
+	}
+#endif
+
 	/* PEC is included */
 	ssif_bmc->pec_support = true;
 	part->pec = part->payload[part->length];
 	addr = GET_8BIT_ADDR(ssif_bmc->client->addr);
+#ifdef LOUIS_DEBUG
+	pr_info("%s():%d\t[SSIF S] [validate_request_part] part->pec: 0x%02x\n", __func__, __LINE__, part->pec);
+	pr_info("%s():%d\t[SSIF S] [validate_request_part] ssif_bmc->client->addr: 0x%02x\n", __func__, __LINE__, ssif_bmc->client->addr);
+	pr_info("%s():%d\t[SSIF S] [validate_request_part] addr: 0x%02x\n", __func__, __LINE__, addr);
+#endif
 	cpec = i2c_smbus_pec(0, &addr, 1);
 	cpec = i2c_smbus_pec(cpec, &part->smbus_cmd, 1);
 	cpec = i2c_smbus_pec(cpec, &part->length, 1);
@@ -652,7 +741,12 @@ static void process_request_part(struct ssif_bmc_ctx *ssif_bmc)
 	struct ssif_part_buffer *part = &ssif_bmc->part_buf;
 	unsigned int len;
 
+#ifdef LOUIS_DEBUG
+	pr_info("%s():%d\t[SSIF S] [process_request_part] part->smbus_cmd: 0x%02x, part->length: %d, ssif_bmc->msg_count: %d\n", __func__, __LINE__, part->smbus_cmd, part->length, ssif_bmc->msg_count);
+#endif
+
 	switch (part->smbus_cmd) {
+	/* 0x2 */
 	case SSIF_IPMI_SINGLEPART_WRITE:
 		/* save the whole part to request*/
 		ssif_bmc->request.header.len = part->length;
@@ -660,12 +754,15 @@ static void process_request_part(struct ssif_bmc_ctx *ssif_bmc)
 		memcpy(ssif_bmc->request.payload, part->payload, part->length);
 
 		break;
+	/* 0x6 */
 	case SSIF_IPMI_MULTIPART_WRITE_START:
 		ssif_bmc->request.header.len = 0;
 		ssif_bmc->request.header.msg_num = ssif_bmc->msg_count;
 
 		fallthrough;
+	/* 0x7 */
 	case SSIF_IPMI_MULTIPART_WRITE_MIDDLE:
+	/* 0x8 */
 	case SSIF_IPMI_MULTIPART_WRITE_END:
 		len = ssif_bmc->request.header.len + part->length;
 		/* Do the bound check here, not allow the request len exceed 254 bytes */
@@ -692,6 +789,9 @@ static void process_smbus_cmd(struct ssif_bmc_ctx *ssif_bmc, u8 *val)
 {
 	/* SMBUS command can vary (single or multi-part) */
 	ssif_bmc->part_buf.smbus_cmd = *val;
+#ifdef LOUIS_DEBUG
+	pr_info("%s():%d\t[SSIF S] ssif_bmc->part_buf.smbus_cmd: %u\n", __func__, __LINE__, *val);
+#endif
 	ssif_bmc->msg_idx = 1;
 	memset(&ssif_bmc->part_buf.payload[0], 0, MAX_PAYLOAD_PER_TRANSACTION);
 
@@ -784,6 +884,10 @@ static void on_read_processed_event(struct ssif_bmc_ctx *ssif_bmc, u8 *val)
 
 static void on_write_requested_event(struct ssif_bmc_ctx *ssif_bmc, u8 *val)
 {
+#ifdef LOUIS_DEBUG
+	pr_info("%s():%d\t[SSIF S] [I2C_SLAVE_WRITE_REQUESTED] ----------------------------\n", __func__, __LINE__);
+#endif
+
 	if (ssif_bmc->state == SSIF_READY || ssif_bmc->state == SSIF_SMBUS_CMD) {
 		ssif_bmc->state = SSIF_START;
 		ssif_bmc->wr_tolerance = true;
@@ -811,10 +915,17 @@ static void on_write_requested_event(struct ssif_bmc_ctx *ssif_bmc, u8 *val)
 
 	ssif_bmc->msg_idx = 0;
 	ssif_bmc->part_buf.address = *val;
+#ifdef LOUIS_DEBUG
+	pr_info("%s():%d\t[SSIF S] [I2C_SLAVE_WRITE_REQUESTED] ssif_bmc->part_buf.address: 0x%x\n", __func__, __LINE__, ssif_bmc->part_buf.address);
+#endif
 }
 
 static void on_write_received_event(struct ssif_bmc_ctx *ssif_bmc, u8 *val)
 {
+#ifdef LOUIS_DEBUG
+	pr_info("%s():%d\t[SSIF S] [I2C_SLAVE_WRITE_RECEIVED] -------------------\n", __func__, __LINE__);
+#endif
+
 	if (ssif_bmc->state == SSIF_READY ||
 	    ssif_bmc->state == SSIF_RES_SENDING) {
 		dev_warn(&ssif_bmc->client->dev,
@@ -853,15 +964,25 @@ static void on_write_received_event(struct ssif_bmc_ctx *ssif_bmc, u8 *val)
 	/* This is response sending state */
 	if (ssif_bmc->state == SSIF_REQ_RECVING) {
 		ssif_bmc->wr_tolerance = false;
+#ifdef LOUIS_DEBUG
+		pr_info("%s():%d\t[SSIF S] [I2C_SLAVE_WRITE_RECEIVED] handle_write_received, val: 0x%x\n", __func__, __LINE__, *val);
+#endif
