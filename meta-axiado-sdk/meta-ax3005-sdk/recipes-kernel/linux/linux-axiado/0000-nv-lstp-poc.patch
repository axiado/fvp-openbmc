diff --git a/Documentation/devicetree/bindings/usb/nvidia,lstp.yaml b/Documentation/devicetree/bindings/usb/nvidia,lstp.yaml
new file mode 100644
index 000000000000..9f441e804de3
--- /dev/null
+++ b/Documentation/devicetree/bindings/usb/nvidia,lstp.yaml
@@ -0,0 +1,428 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/usb/nvidia,lstp.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: LSTP vendor specific USB gadget function
+
+maintainers:
+  - Louis Liao <lliao@axiado.com>
+
+description: |
+  LSTP (Low Speed Transport Protocol) is the NVIDIA vendor specific USB
+  protocol used by the OpenSMA server management adapter firmware to tunnel
+  low speed buses to a USB host.  This node describes the device side of
+  that protocol: the set of LSTP channels a Linux machine offers to an LSTP
+  host, and the local I2C adapters, GPIO lines, SPI devices and UARTs
+  backing them.
+
+  Channel 0 is always the management channel, through which a host
+  enumerates the remaining channels.  Channel identifiers are part of the
+  interface a host sees, so they are given explicitly and must cover
+  0..number-of-channels-1 without gaps.
+
+  The function itself is instantiated through configfs once the driver is
+  loaded, for example:
+
+    mkdir /sys/kernel/config/usb_gadget/g1/functions/lstp.0
+
+properties:
+  compatible:
+    const: nvidia,lstp
+
+  "#address-cells":
+    const: 1
+
+  "#size-cells":
+    const: 0
+
+patternProperties:
+  "^channel@[0-9a-f]+$":
+    type: object
+    description: One LSTP channel.
+
+    properties:
+      reg:
+        maxItems: 1
+        description: LSTP channel identifier.
+
+      nvidia,channel-type:
+        enum: [management, i2c, gpio, spi, uart, virtual-uart]
+        description: |
+          Channel type as reported to the host.  Exactly one channel of
+          type "management" must exist and it must be channel 0.
+
+          "uart" and "virtual-uart" are both reported to the host as UART
+          channels.  A "uart" channel hands over one of the local serial
+          controllers, a "virtual-uart" channel has no controller behind it
+          and shows up locally as /dev/ttyVUARTn instead.
+
+      nvidia,channel-name:
+        $ref: /schemas/types.yaml#/definitions/string
+        maxLength: 16
+        description: |
+          Name reported in the channel configuration blob.  Defaults to the
+          node name.  Carried on the wire as a fixed 16 byte NUL padded
+          field, so longer names are truncated.
+
+    required:
+      - reg
+      - nvidia,channel-type
+
+    allOf:
+      - if:
+          properties:
+            nvidia,channel-type:
+              const: i2c
+        then:
+          properties:
+            i2c-parent:
+              $ref: /schemas/types.yaml#/definitions/phandle
+              description: The i2c adapter this channel exposes.
+
+            nvidia,i2c-speed:
+              description: |
+                Bus speed in Hz reported to the host.  Defaults to the
+                clock-frequency of the adapter node, or 100 kHz.  This is
+                informational only; the adapter is not reconfigured.
+              enum: [100000, 400000, 1000000, 3400000]
+
+          required:
+            - i2c-parent
+
+      - if:
+          properties:
+            nvidia,channel-type:
+              const: spi
+        then:
+          properties:
+            spi:
+              $ref: /schemas/types.yaml#/definitions/phandle-array
+              minItems: 1
+              maxItems: 2
+              items:
+                maxItems: 1
+              description: |
+                One phandle per chip select, each pointing at an
+                "nvidia,lstp-spi" child of an SPI controller.  All of them
+                must sit on the same controller.
+
+            nvidia,cs-gpios:
+              minItems: 1
+              maxItems: 2
+              description: |
+                Chip selects driven by this driver instead of by the SPI
+                controller, which is how the OpenSMA firmware behaves.  When
+                present only the first "spi" phandle is used for transfers
+                and the controller is asked for SPI_NO_CS mode.  When absent
+                the SPI core drives chip select and is asked to hold it
+                asserted between messages, which needs a controller that
+                honours spi_transfer.cs_change.
+
+          required:
+            - spi
+
+      - if:
+          properties:
+            nvidia,channel-type:
+              const: uart
+        then:
+          properties:
+            uart:
+              $ref: /schemas/types.yaml#/definitions/phandle
+              description: |
+                Points at an "nvidia,lstp-uart" child of a serial controller,
+                which is the serdev device this channel drives.  Claiming it
+                takes the port away from userspace for as long as the channel
+                exists.
+
+            current-speed:
+              default: 115200
+              description: Initial baud rate, also reported to the host.
+
+            nvidia,parity:
+              enum: [none, odd, even, mark, space]
+              default: none
+              description: |
+                Initial parity, also reported to the host.  serdev cannot
+                express "mark" or "space", so those are rejected.
+
+            nvidia,flow-control:
+              enum: [none, xon-xoff, rts-cts, dtr-dsr]
+              default: none
+              description: |
+                Initial flow control, also reported to the host.  serdev only
+                drives RTS/CTS, so "xon-xoff" and "dtr-dsr" are rejected.
+
+            nvidia,drive-strength-ma:
+              $ref: /schemas/types.yaml#/definitions/uint32
+              description: Reported drive strength, in mA.
+
+            nvidia,slew-rate:
+              $ref: /schemas/types.yaml#/definitions/uint32
+              description: Reported slew rate, in 100 ps steps.
+
+            nvidia,input-debounce-us:
+              $ref: /schemas/types.yaml#/definitions/uint32
+              description: Reported input debounce time, in us.
+
+            nvidia,glitch-filter-ns:
+              $ref: /schemas/types.yaml#/definitions/uint32
+              description: Reported glitch filter width, in ns.
+
+          required:
+            - uart
+
+      - if:
+          properties:
+            nvidia,channel-type:
+              const: virtual-uart
+        then:
+          description: |
+            A virtual UART channel takes no phandle: it registers a serial
+            driver of its own, so the bytes the host sends arrive on a local
+            /dev/ttyVUARTn and whatever is written there goes back to the
+            host.  Lines are handed out in probe order, so a device tree with
+            a single virtual UART channel always gets /dev/ttyVUART0.
+
+            Nothing is framed on the way to the host, so the properties below
+            only seed what the channel reports through the management
+            ReadConfig command.  A local termios change or a host WriteConfig
+            updates that; no framing is ever refused.
+          properties:
+            current-speed:
+              default: 115200
+              description: Initial baud rate reported to the host.
+
+            nvidia,data-bits:
+              $ref: /schemas/types.yaml#/definitions/uint32
+              enum: [5, 6, 7, 8]
+              default: 8
+              description: Initial data bits reported to the host.
+
+            nvidia,stop-bits:
+              $ref: /schemas/types.yaml#/definitions/uint32
+              enum: [1, 2]
+              default: 1
+              description: Initial stop bits reported to the host.
+
+            nvidia,parity:
+              enum: [none, odd, even, mark, space]
+              default: none
+              description: Initial parity reported to the host.
+
+            nvidia,flow-control:
+              enum: [none, xon-xoff, rts-cts, dtr-dsr]
+              default: none
+              description: Initial flow control reported to the host.
+
+            nvidia,drive-strength-ma:
+              $ref: /schemas/types.yaml#/definitions/uint32
+              description: Reported drive strength, in mA.
+
+            nvidia,slew-rate:
+              $ref: /schemas/types.yaml#/definitions/uint32
+              description: Reported slew rate, in 100 ps steps.
+
+            nvidia,input-debounce-us:
+              $ref: /schemas/types.yaml#/definitions/uint32
+              description: Reported input debounce time, in us.
+
+            nvidia,glitch-filter-ns:
+              $ref: /schemas/types.yaml#/definitions/uint32
+              description: Reported glitch filter width, in ns.
+
+      - if:
+          properties:
+            nvidia,channel-type:
+              const: gpio
+        then:
+          properties:
+            "#address-cells":
+              const: 1
+
+            "#size-cells":
+              const: 0
+
+          patternProperties:
+            "^pin@[0-9a-f]+$":
+              type: object
+              description: One GPIO line of the channel.
+
+              properties:
+                reg:
+                  maxItems: 1
+                  description: |
+                    Index of this line within the channel, as used by the
+                    GPIO channel commands.  Must cover 0..number-of-pins-1
+                    without gaps.
+
+                gpios:
+                  maxItems: 1
+
+                label:
+                  $ref: /schemas/types.yaml#/definitions/string
+                  maxLength: 32
+                  description: |
+                    Name reported to the host.  Defaults to the node name.
+
+                nvidia,allow-set-irq:
+                  type: boolean
+                  description: |
+                    Let the host arm an edge interrupt on this line.  Only
+                    meaningful for lines whose gpio controller can produce
+                    interrupts, and only for lines not owned by another
+                    driver.
+
+                nvidia,allow-direction-control:
+                  type: boolean
+                  description: |
+                    Let the host change the direction of this line.  Leave
+                    unset for lines owned by another driver or critical to
+                    the platform.  A channel with no such line reports
+                    itself as locked.
+
+                nvidia,default-output-high:
+                  type: boolean
+                  description: |
+                    Drive the line high when the host switches it to output.
+
+                nvidia,output-persist:
+                  type: boolean
+                  description: |
+                    Reported in the pin configuration blob: the output value
+                    survives a direction change.
+
+                nvidia,drive:
+                  enum: [push-pull, open-drain, open-source]
+                  default: push-pull
+                  description: |
+                    Reported in the pin configuration blob.  Informational;
+                    configure the pad through pinctrl.
+
+                nvidia,bias:
+                  enum: [none, pull-up, pull-down]
+                  default: none
+                  description: |
+                    Reported in the pin configuration blob.  Informational;
+                    configure the pad through pinctrl.
+
+                nvidia,bias-strength:
+                  $ref: /schemas/types.yaml#/definitions/uint32
+                  description: Reported bias strength, in 16 ohm steps.
+
+                nvidia,drive-strength-ma:
+                  $ref: /schemas/types.yaml#/definitions/uint32
+                  description: Reported drive strength, in mA.
+
+                nvidia,slew-rate:
+                  $ref: /schemas/types.yaml#/definitions/uint32
+                  description: Reported slew rate, in 100 ps steps.
+
+                nvidia,input-debounce-us:
+                  $ref: /schemas/types.yaml#/definitions/uint32
+                  description: Reported input debounce time, in us.
+
+              required:
+                - reg
+                - gpios
+
+              additionalProperties: false
+
+    unevaluatedProperties: false
+
+required:
+  - compatible
+  - "#address-cells"
+  - "#size-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        lstp_spi: spi-lstp@0 {
+            compatible = "nvidia,lstp-spi";
+            reg = <0>;
+            spi-max-frequency = <18750000>;
+        };
+    };
+
+    serial {
+        lstp_uart: serial-lstp {
+            compatible = "nvidia,lstp-uart";
+        };
+    };
+
+    lstp {
+        compatible = "nvidia,lstp";
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        channel@0 {
+            reg = <0>;
+            nvidia,channel-type = "management";
+            nvidia,channel-name = "AST2600_BMC";
+        };
+
+        channel@1 {
+            reg = <1>;
+            nvidia,channel-type = "spi";
+            nvidia,channel-name = "SPI";
+            spi = <&lstp_spi>;
+            nvidia,cs-gpios = <&gpio0 0 GPIO_ACTIVE_LOW>,
+                              <&gpio0 1 GPIO_ACTIVE_LOW>;
+        };
+
+        channel@2 {
+            reg = <2>;
+            nvidia,channel-type = "i2c";
+            nvidia,channel-name = "I2C_SSD0";
+            i2c-parent = <&i2c0>;
+            nvidia,i2c-speed = <400000>;
+        };
+
+        channel@3 {
+            reg = <3>;
+            nvidia,channel-type = "gpio";
+            nvidia,channel-name = "GPIO";
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            pin@0 {
+                reg = <0>;
+                label = "SSD0_PRSNT_N";
+                gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
+                nvidia,allow-set-irq;
+                nvidia,bias = "pull-up";
+            };
+
+            pin@1 {
+                reg = <1>;
+                label = "SSD0_RESET_N";
+                gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
+                nvidia,allow-direction-control;
+            };
+        };
+
+        channel@4 {
+            reg = <4>;
+            nvidia,channel-type = "uart";
+            nvidia,channel-name = "HOST_SOL";
+            uart = <&lstp_uart>;
+            current-speed = <115200>;
+        };
+
+        channel@5 {
+            reg = <5>;
+            nvidia,channel-type = "virtual-uart";
+            nvidia,channel-name = "BMC_SOL";
+            current-speed = <115200>;
+        };
+    };
